# Copiar a .env en la raíz. Cambiar las dos claves antes del primer arranque (8-30 caracteres ASCII).
# Estos valores son ejemplos públicos; no son credenciales de un entorno real.
ORACLE_PASSWORD=CambiarClaveSistema_2026
DB_USER=NOMINA2
DB_PASSWORD=CambiarClaveAplicacion_2026

# Desarrollo local: Compose sustituye el host/puerto por nomina2-db:1521/XEPDB1.
DB_CONNECT_STRING=localhost:1521/XEPDB1
DB_PORT=1521
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT_SECONDS=60
DB_QUEUE_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_CALL_TIMEOUT_MS=5000

# API: Compose usa NODE_ENV=production y PORT=3000 dentro del contenedor.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
TZ=America/Guatemala

# nginx y Vite: la URL pública de la API es siempre relativa (/api).
WEB_PORT=8080
VITE_PROXY_TARGET=http://localhost:3000
