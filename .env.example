# Copiar a .env en la raíz. Cambiar claves Oracle (8-30 caracteres ASCII) y ADMIN antes del arranque.
# Estos valores son ejemplos públicos; no son credenciales de un entorno real.
ORACLE_PASSWORD=CambiarClaveSistema_2026
DB_USER=NOMINA2
DB_PASSWORD=CambiarClaveAplicacion_2026

# ADMIN inicial: obligatorio para seeds. La reejecución conserva la cuenta y su contraseña.
# Cambiar ADMIN_PASSWORD antes de instalar (10-128 caracteres, mayúscula, minúscula, número, símbolo).
ADMIN_USER=admin.sistemas
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiarAdmin!2026

# Desarrollo local: Compose sustituye el host/puerto por nomina2-db:1521/XEPDB1.
DB_CONNECT_STRING=localhost:1521/XEPDB1
DB_PORT=1521
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT_SECONDS=60
DB_QUEUE_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_CALL_TIMEOUT_MS=5000

# API: Compose usa NODE_ENV=production y PORT=3000 dentro del contenedor.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
TZ=America/Guatemala
SESSION_IDLE_MINUTES=30
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_MINUTES=15
# Vacío: IP del socket. En despliegue, solo IPs/CIDR de proxies administrados (separados por coma).
TRUST_PROXY_CIDRS=

# nginx y Vite: la URL pública de la API es siempre relativa (/api).
WEB_PORT=8080
WEB_HTTPS_PORT=8443
VITE_PROXY_TARGET=http://localhost:3000
