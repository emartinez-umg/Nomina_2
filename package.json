{
  "name": "nomina2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21",
    "npm": ">=10"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc --project tsconfig.e2e.json",
    "lint": "npm run lint --workspaces && eslint --config eslint.base.mjs e2e playwright.config.ts scripts/exportar-bd*.mjs scripts/verificar-e2e.mjs scripts/servir-*-e2e.mjs scripts/verificar-migracion-v0.mjs scripts/verificar-arranque.mjs scripts/seed-*.js scripts/verify-seed.js scripts/verificar-seguridad.mjs",
    "test": "npm run test --workspaces && npm run test:export",
    "verify:infra": "node --env-file=.env scripts/verificar-infra.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:verify": "node --import tsx --env-file=.env scripts/verificar-db.mjs",
    "db:export": "node --import tsx scripts/exportar-bd.mjs",
    "test:export": "node --test scripts/exportar-bd.test.mjs",
    "verify:codigos": "node --env-file=.env scripts/verificar-seguridad.mjs --codigos",
    "verify:security": "node --env-file=.env scripts/verificar-seguridad.mjs",
    "verify:prestaciones": "node --env-file=.env scripts/verificar-seguridad.mjs --prestaciones",
    "verify:comunicacion": "node --env-file=.env scripts/verificar-seguridad.mjs --comunicacion",
    "verify:solicitudes": "node --env-file=.env scripts/verificar-seguridad.mjs --solicitudes",
    "test:e2e": "node --env-file=.env scripts/verificar-e2e.mjs",
    "verify:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check && npm run verify:secrets && npm run db:verify && npm run verify:migration && npm run verify:migration:v1 && npm run verify:empleados && npm run verify:pagos && npm run verify:novedades && npm run verify:vacaciones && npm run verify:catalogos && npm run verify:horarios && npm run verify:empresa && npm run verify:ubicaciones && npm run verify:codigos && npm run verify:security && npm run verify:prestaciones && npm run verify:solicitudes && npm run verify:tableros && npm run verify:comunicacion && npm run test:e2e -- --production && npm run verify:infra && npm run verify:clean",
    "verify:clean": "node scripts/verificar-arranque.mjs",
    "verify:secrets": "node scripts/auditar-secretos.mjs",
    "tls:trust": "node --env-file=.env scripts/confiar-tls-macos.mjs",
    "verify:ubicaciones": "node --env-file=.env scripts/verificar-seguridad.mjs --ubicaciones",
    "verify:empresa": "node --env-file=.env scripts/verificar-seguridad.mjs --empresa",
    "verify:horarios": "node --env-file=.env scripts/verificar-seguridad.mjs --horarios",
    "verify:empleados": "node --env-file=.env scripts/verificar-seguridad.mjs --empleados",
    "verify:vacaciones": "node --env-file=.env scripts/verificar-seguridad.mjs --vacaciones",
    "verify:novedades": "node --env-file=.env scripts/verificar-seguridad.mjs --novedades",
    "verify:pagos": "node --env-file=.env scripts/verificar-seguridad.mjs --pagos",
    "verify:migration": "node --import tsx --env-file=.env scripts/verificar-migracion-v0.mjs",
    "verify:catalogos": "node --env-file=.env scripts/verificar-seguridad.mjs --catalogos",
    "verify:tableros": "node --env-file=.env scripts/verificar-seguridad.mjs --tableros",
    "verify:migration:v1": "node --import tsx --env-file=.env scripts/verificar-migracion-v0.mjs --from-v1",
    "seed:demo": "node scripts/seed-demo.js",
    "test:seed-demo": "node --env-file=.env scripts/verificar-seguridad.mjs --seed-demo",
    "seed:remote": "node scripts/seed-remote.js",
    "seed:export-sql": "node scripts/seed-export-sql.js",
    "test:seed-export": "node --env-file=.env scripts/verificar-seguridad.mjs --seed-export",
    "verify:seed": "node scripts/verify-seed.js",
    "test:seed-verify": "node --env-file=.env scripts/verificar-seguridad.mjs --seed-verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
